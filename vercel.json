{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "ummul-bannin-madrasah",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "DATABASE_URL": "postgresql://neondb_owner:npg_cB1QbSRFli5J@ep-curly-dawn-b4fml3t0-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require",
    "SESSION_SECRET": "ummul-bannin-madrasah-secret-key-2026",
    "NODE_ENV": "production"
  }
}
